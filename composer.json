{
	"name": "asm-wp-plugin/asm-wp-plugin",
	"description": "WordPress plugin that shows adoptable animals from Animal Shelter Manager.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": ">=6.8",
		"yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint-fix": "phpcbf"
	}
}
